<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Ryujinx.LibHac pre-releases are only published on git.ryujinx.app, which is not always reachable.
             nuget-local holds the exact package the build pins (sha256 in nuget-local/README.md). -->
        <add key="local" value="nuget-local" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="local">
            <package pattern="Ryujinx.LibHac" />
        </packageSource>
    </packageSourceMapping>
</configuration>
